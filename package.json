{
  "name": "disclosed-contracts",
  "version": "0.1.0",
  "description": "Disclosed - verifiable sponsorship disclosure registry. Smart contracts.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run contracts:build",
    "build:all": "npm run contracts:build && npm run graph:build",
    "contracts:build": "hardhat compile",
    "test": "npm run test:contracts",
    "test:all": "npm run test:contracts && npm run graph:test",
    "test:contracts": "hardhat test",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage",
    "deploy:settlement": "hardhat run scripts/deploy-settlement.ts --network sepolia",
    "graph:codegen": "npm --prefix subgraph run codegen",
    "graph:build": "npm --prefix subgraph run build",
    "graph:test": "npm --prefix subgraph test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
