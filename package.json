{
  "name": "adreceipt",
  "version": "0.1.0",
  "description": "Verifiable payment receipts for sponsored AI recommendations.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run contracts:build && npm run graph:build",
    "contracts:build": "hardhat compile",
    "test": "npm run test:contracts && npm run graph:test",
    "test:contracts": "hardhat test",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage",
    "graph:codegen": "graph codegen --output-dir subgraph/generated subgraph/subgraph.yaml",
    "graph:build": "npm run graph:codegen && graph build subgraph/subgraph.yaml",
    "graph:test": "graph test"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "hardhat": "^2.22.17",
    "matchstick-as": "0.6.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
