# Copy to .env and fill in. .env is gitignored - never put real values here.
#
# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# RPC endpoint for Sepolia (ENSv2 beta lives here)
SEPOLIA_RPC_URL=

# Optional independent RPC for V2 settlement preflight/confirmation. This keeps
# a rate-limited application RPC from blocking an otherwise valid review packet.
SEPOLIA_OPERATOR_RPC_URL=

# Deployer key. Test key only - never a funded mainnet key.
DEPLOYER_PRIVATE_KEY=

# Circle test USDC on Ethereum Sepolia. Override only after verifying another ERC-20.
SETTLEMENT_ASSET=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Optional, for contract verification
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Roles granted at deploy time
# ---------------------------------------------------------------------------

# Holds DEFAULT_ADMIN_ROLE on every contract. Defaults to the deployer.
ADMIN_ADDRESS=

# The Chainlink CRE Forwarder that will deliver workflow reports. Leave blank
# until the workflow is registered; the role can be granted later.
CRE_FORWARDER=

# Operator address allowed to replay CRE CLI simulation output through
# submitDomainVerification / submitTierAttestation. Set this before deploying -
# it is what carries the demo while no Forwarder exists.
CRE_SIMULATOR=

# ---------------------------------------------------------------------------
# Deployment parameters - all optional, defaults shown
# ---------------------------------------------------------------------------

# Parent name subnames are issued under, e.g. deployco.disclosed.eth.
# Immutable once deployed, but only DisclosedSubnameRegistry depends on it.
PARENT_NAME=disclosed.eth

# How long a placement deposit is locked, in seconds. Default 7 days.
# Hard-capped at 30 days by the contract. Use 300 for a live demo.
PLACEMENT_LOCK=604800

# Smallest accepted placement, in ether. Default 0.001.
MIN_PLACEMENT=0.001

# How long a tier attestation counts as current, in seconds. Default 30 days,
# hard-capped at 180 days.
TIER_VALIDITY=2592000

# Suspicious-pattern rule: registrations younger than this count as new.
# Default 7 days.
MAX_ACCOUNT_AGE=604800

# Suspicious-pattern rule: placement count must strictly exceed this. Default 10.
MIN_PLACEMENTS=10

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------

# Set to "true" to print a gas report when running tests.
REPORT_GAS=

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------

# Which deployments/<network>.json records the backend reads.
NETWORK=sepolia

# HTTP port for the local API.
PORT=8787

# Optional domain-control signal. Both resolvers must agree before recording.
CRE_SIMULATOR_PRIVATE_KEY=
DNS_RECORD_PREFIX=_disclosed
DNS_RECORD_KEY=disclosed-verification
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Server-only receipt verification. Never expose GRAPH_API_KEY to the browser.
GRAPH_QUERY_URL=
GRAPH_API_KEY=
GRAPH_MAX_BLOCK_LAG=20

# V2 campaign and contextual-decision persistence. Production has no in-memory
# or JSON fallback: if PostgreSQL is unavailable, V2 writes fail clearly.
DATABASE_URL=postgresql://adreceipt:change-me@127.0.0.1:5432/adreceipt

# Server-side organic-answer provider. Queries are sent with Responses API
# storage disabled; the application does not persist raw queries.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
PLACEMENT_SETTLEMENT_ADDRESS=
V2_PUBLISHER_ADDRESS=
V2_PAYER_ADDRESS=
V2_RECIPIENT_ADDRESS=
RECEIPT_READ_LIMIT=60
RECEIPT_READ_WINDOW_MS=60000

# Privy server wallet and its attached default-deny provider policy.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_POLICY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
