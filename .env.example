# Copy to .env and fill in. .env is gitignored - never put real values here.
#
# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# RPC endpoint for Sepolia (ENSv2 beta lives here)
SEPOLIA_RPC_URL=

# Deployer key. Test key only - never a funded mainnet key.
DEPLOYER_PRIVATE_KEY=

# Optional, for contract verification
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Roles granted at deploy time
# ---------------------------------------------------------------------------

# Holds DEFAULT_ADMIN_ROLE on every contract. Defaults to the deployer.
ADMIN_ADDRESS=

# The Chainlink CRE Forwarder that will deliver workflow reports. Leave blank
# until the workflow is registered; the role can be granted later.
CRE_FORWARDER=

# Operator address allowed to replay CRE CLI simulation output through
# submitDomainVerification / submitTierAttestation. Set this before deploying -
# it is what carries the demo while no Forwarder exists.
CRE_SIMULATOR=

# ---------------------------------------------------------------------------
# Deployment parameters - all optional, defaults shown
# ---------------------------------------------------------------------------

# Parent name subnames are issued under, e.g. deployco.disclosed.eth.
# Immutable once deployed, but only DisclosedSubnameRegistry depends on it.
PARENT_NAME=disclosed.eth

# How long a placement deposit is locked, in seconds. Default 7 days.
# Hard-capped at 30 days by the contract. Use 300 for a live demo.
PLACEMENT_LOCK=604800

# Smallest accepted placement, in ether. Default 0.001.
MIN_PLACEMENT=0.001

# How long a tier attestation counts as current, in seconds. Default 30 days,
# hard-capped at 180 days.
TIER_VALIDITY=2592000

# Suspicious-pattern rule: registrations younger than this count as new.
# Default 7 days.
MAX_ACCOUNT_AGE=604800

# Suspicious-pattern rule: placement count must strictly exceed this. Default 10.
MIN_PLACEMENTS=10

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------

# Set to "true" to print a gas report when running tests.
REPORT_GAS=
