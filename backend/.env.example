# Backend config. Values here override the repo-root .env.
# Copy to backend/.env only if you need to differ from the root file.

# Which deployments/<network>.json to read addresses from.
NETWORK=sepolia

# Falls back to the repo-root .env if unset.
SEPOLIA_RPC_URL=

# Attestation key. Holds SIMULATOR_ROLE only - never the deployer key.
CRE_SIMULATOR_PRIVATE_KEY=

# HTTP port for the challenge/status API.
PORT=8787

# DNS challenge record shape: <prefix>.<domain> TXT "<key>=0x..."
DNS_RECORD_PREFIX=_disclosed
DNS_RECORD_KEY=disclosed-verification

# Resolvers queried for the challenge. All must agree before we attest.
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Server-only receipt verification. Never expose GRAPH_API_KEY to the browser.
GRAPH_QUERY_URL=
GRAPH_API_KEY=
GRAPH_MAX_BLOCK_LAG=20
PLACEMENT_SETTLEMENT_ADDRESS=

# Privy server wallet. PRIVY_POLICY_ID is the attached provider policy ID, not a wallet private key.
# Creating resources and sending transactions are explicit live actions.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_POLICY_ID=
# Base64 P-256 authorization key from Privy Keys and quorums. This is not a wallet private key.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
